
# InfluxDB v2 settings
INFLUX_URL=http://influxdb:8086
INFLUX_ORG=my-org
INFLUX_BUCKET=sensors
INFLUX_TOKEN=REPLACE_WITH_YOUR_TOKEN
# API settings
API_LOG_LEVEL=info
# CORS (comma-separated origins, or *)
CORS_ORIGINS=http://wise-net.io:5173,http://127.0.0.1:5173,http://wise-net.io:5174,http://127.0.0.1:5174,http://wise-net.io,https://wise-net.io
