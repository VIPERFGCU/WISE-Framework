# FastAPI logging/CORS
API_LOG_LEVEL = info
# Allow both common Vite dev ports (5173 default, 5174 fallback)
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Influx -IMPORTANT: service name inside Docker!
INFLUX_URL=http://influxdb:8086
INFLUX_TOKEN=super-long-admin-token
INFLUX_ORG=my-org
INFLUX_BUCKET=sensors

# Security
API_KEY=devkey
JWT_SECRET=super-secret-change-me
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=45

# MQTT Settings
MQTT_HOST=10.0.0.155
MQTT_PORT=1883
MQTT_TOPIC=devices/+/data
